            border-radius: 28px;
            padding: 14px;
            box-shadow: inset 0 2px 8px rgba(140, 110, 80, 0.12), 0 8px 24px rgba(160, 130, 100, 0.15);
            border: 1px solid #ede3d6;
            width: 100%;
            max-width: 560px;
            touch-action: manipulation;
        }

        #beadCanvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 20 / 18;
            border-radius: 16px;
            background: #f5ede4;
            cursor: pointer;
            touch-action: none;
            image-rendering: pixelated;
        }

        /* ===== 工具栏 ===== */
        .toolbar {
