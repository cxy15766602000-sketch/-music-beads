            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 10px 14px;
            margin-top: 18px;
            padding: 10px 16px;
            background: rgba(245, 237, 228, 0.55);
            border-radius: 56px;
            backdrop-filter: blur(4px);
            border: 1px solid rgba(220, 205, 190, 0.3);
        }

